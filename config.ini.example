; Copiez ce fichier en config.ini puis adaptez-le (ou réglez tout depuis webadmin).
; Toutes les options sont décrites dans docs/FLIGHT_DISPLAY_DOCUMENTATION.md, section 8.

[general]
; Langue de webadmin et du texte affiché à l'écran : fr (français), en (anglais) ou une langue ajoutée dans lang/
language = fr

[position]
; Coordonnées de votre domicile, en degrés décimaux (exemple : Paris, à remplacer)
latitude = 44.82946
longitude = -0.71531
; Rayon couvert par la carte (km)
radius_km = 30

[map]
; Clé API CARTO, nécessaire pour construire la carte (lue par build_map_vector.py)
carto_key =

[mapstyle]
; Style du fond de carte (modifiable depuis webadmin, Réglages, Style de la carte). Demande de reconstruire la carte.
; Thème : dark, black, light, voyager, radar
preset = dark
; Éléments affichés (true ou false)
show_roads_major = false
show_roads_minor = false
show_rail = false
show_buildings = false
; Couleur personnalisée (#rrggbb) : vide = couleur du thème, par exemple color_water = #1a3a5c
color_water =

[cities]
; Noms de lieux sur la carte
show = true
kinds = city,town
max_labels = 25
font_size = 20

[api]
poll_seconds = 10
details_pause_seconds = 4
stale_seconds = 30

[sources]
# Sources des avions : fr24 (Flightradar24) et/ou tar1090 (serveur ADS-B local). Voir la documentation (9.10).
fr24_enabled = true
tar1090_enabled = false
order = fr24,tar1090
# combine : toutes les sources cumulees | primary : source principale + complements | failover : secours
mode = combine
# pour combine : freshest (position la plus recente) | priority (source la mieux classee)
overlap = freshest
# complete les avions vus seulement par tar1090 via adsbdb.com
enrich = true

[tar1090]
# url = http://adresse/tar1090/data/aircraft.json
interval_seconds = 2

[display]
# couleur des icones selon la source (voir [sources])
color_by_source = false
plane_color_fr24 = #ffd250
plane_color_tar1090 = #5ac8ff
plane_color_multi = #78e68c
fullscreen = true
fps = 10
altitude_unit = ft
speed_unit = kmh
max_altitude_ft = 0
icon_scale = 1.25
; Couleurs des avions (#rrggbb) : avion du panneau photo, autres avions, avions de type inconnu
plane_color_panel = #ff4646
plane_color_known = #ffd250
plane_color_unknown = #ffaa5a
; Taille de la carte en pixels, utilisée par build_map_vector.py pour construire l'image de fond
; (main.py lit la taille réelle dans map_meta.json). Modifier ces valeurs demande de reconstruire la carte.
width = 1920
height = 1080

[panel]
width = 480
rotate_seconds = 12
; Répéter le crédit du photographe sous la photo (il est déjà visible dans l'image)
show_credit = true
; Angles où le panneau photo peut s'afficher (false = jamais dans cet angle)
corner_top_left = true
corner_top_right = true
corner_bottom_left = true
corner_bottom_right = true

[panel_content]
; Texte du panneau photo : ordre, affichage (show_*), taille (small, medium, large), gras, italique, même ligne
; Réglage conseillé depuis webadmin (Réglages, Panneau photo, onglet Contenu du texte). Le crédit du photographe se masque avec show_credit dans [panel].
order = model,callsign,registration,airline,route,altitude,speed,credit
show_callsign = true
callsign_same_line = false
callsign_size = medium
registration_size = medium
model_size = medium
route_same_line = true

[label]
; Étiquettes à côté des avions : ordre, affichage (show_*), taille (small, medium, large), gras, italique, même ligne
; Réglage conseillé depuis webadmin (Réglages, Étiquettes des avions). Seules les valeurs modifiées sont utiles.
show_registration = true
order = model,callsign,registration,airline,route,altitude,speed
registration_same_line = true
model_bold = true
registration_bold = true
registration_size = small
show_callsign = true
callsign_size = small
callsign_bold = true
callsign_same_line = false

[ground]
show_list = true
max_rows = 8
width = 780
; Code IATA de l'aéroport proche (ex. CDG), ou vide
airport_iata =
min_speed_kt = 0
landed_alt_ft = 2000
landed_keep_minutes = 10

[rings]
; Cercles de distance autour de la maison (tracés par le programme, sans reconstruire la carte)
show = true
count = 3
first_km = 5
step_km = 5
width = 1
color = #2d3746
show_labels = false

[alert]
radius_km = 5
; true : la distance d'alerte est celle du premier cercle (first_km) ; false : radius_km
link_first_ring = false
sound = true
volume = 0.4
pulse_seconds = 3
alpha_min = 10
alpha_max = 60
min_altitude_ft = 0
max_altitude_ft = 10000
sound_on_start = false
simulate_on_start = false
simulate_seconds = 3

[server]
; Adresse d'écoute : 0.0.0.0 = tout le réseau, 127.0.0.1 = le Pi seul
host = 0.0.0.0
port = 8080
user = admin
; Mot de passe de l'interface (vide = pas de protection, à éviter)
password =

[app]
; Dossier de l'application (vide = dossier de webadmin.py)
dir =
config = config.ini
runtime = cache/runtime.json
service = flightdisplay
; Interpréteur utilisé pour build_map_vector.py (rempli par l'installeur)
python =
build_script = build_map_vector.py
sudo = sudo -n
systemctl =
journalctl =

[screen]
helper = /usr/local/bin/flight-screen
flag = /run/flight-screen-off

[build]
; Arrêter l'affichage pendant la reconstruction de la carte
stop_display = true

[update]
; Canal : stable (versions publiées vX.Y.Z, recommandé) ou latest (dernier commit, développement)
channel = stable
; Vérifier régulièrement si une nouvelle version existe sur GitHub
auto_check = true
; Intervalle entre deux vérifications, en heures (1 à 48)
check_hours = 12
; Installer automatiquement les mises à jour dès qu'elles sont détectées (nécessite auto_check)
auto_install = false

[schedule]
; Planning d'allumage de l'écran : réglé depuis webadmin (Réglages, Planning de l'écran)
; Une ligne par jour, plages HH:MM-HH:MM séparées par des virgules, ex. mon = 07:00-09:30,18:00-24:00
enabled = false

[storage]
; Seuil d'alerte d'occupation du disque, en % (alerte orange 10 points avant)
warn_percent = 90
; Nettoyage automatique du cache des photos : au-delà du quota, les plus anciennes sont supprimées (jusqu'à 80 % du quota)
auto_clean = false
cache_max_mb = 200

[mqtt]
enabled = false
host =
port = 1883
user =
password =
tls = false
base_topic = flightdisplay
discovery_prefix = homeassistant
device_name = Flight display
interval = 30
